# Copia este archivo como ".env" (en esta misma carpeta) y pon tus valores reales.
# El archivo .env NO se sube a GitHub.

# --- Obligatorios ---
# Contraseña de tu usuario de PostgreSQL
DB_PASSWORD=tu_contraseña_de_postgres
# Clave para firmar las sesiones (JWT): mínimo 32 caracteres aleatorios.
# Puedes generar una con:  node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
# (el backend NO arranca si dejas el valor de ejemplo)
JWT_SECRETO=cambia_esto_por_una_clave_larga_y_aleatoria_de_32_o_mas

# --- Opcionales (estos son los valores por defecto) ---
# DB_URL=jdbc:postgresql://localhost:5432/ellas
# DB_USUARIO=postgres
# CORS_ORIGENES=http://localhost:5173
# En el servidor, si se usa la APK de Android, hay que agregar su origen (https://localhost), p. ej.:
# CORS_ORIGENES=https://tu-dominio.com,https://localhost
